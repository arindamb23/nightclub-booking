# ================================================================
#  AI Hunters ComfyFlow v1.0.6 - configuration
#  Ports are read from THIS file only. Setup.bat copies it to .env.
# ================================================================
APP_ENV=production

# --- Application ports (edit here only) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3015
FRONTEND_PORT=5091

# --- ComfyUI (installed by Setup.bat into .\comfyui) ---
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_DIR=comfyui\ComfyUI
COMFYUI_PYTHON=comfyui\venv\Scripts\python.exe
# Extra ComfyUI start arguments. Setup.bat sets --cpu when no NVIDIA GPU is found.
COMFYUI_EXTRA_ARGS=
# PyTorch wheel index used by Setup.bat (auto: CUDA 12.8 with an NVIDIA GPU, otherwise CPU)
TORCH_INDEX_URL=auto
# Set to false to skip installing ComfyUI (use your own ComfyUI via COMFYUI_HOST/PORT)
INSTALL_COMFYUI=true

# --- Models ---
# Empty = <COMFYUI_DIR>\models. A custom folder is registered with ComfyUI automatically.
MODELS_DIR=
# 1 = one model at a time (recommended: big files, unstable connections). Queued ones start automatically.
MAX_PARALLEL_DOWNLOADS=1
AUTO_DOWNLOAD_MODELS=true
# Optional tokens for gated / private models
HF_TOKEN=
CIVITAI_TOKEN=

# --- App data (workflows, runs, outputs, uploads, models.json) ---
DATA_DIR=data
